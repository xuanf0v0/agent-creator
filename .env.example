# 飞书自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# QQ 开放平台机器人
QQ_BOT_APP_ID=
QQ_BOT_SECRET=

# n8n 连接器后端（AutoFlow 2.0 集成）
# 生成方式：-join ((48..57) + (97..122) | Get-Random -Count 32 | ForEach-Object { [char]$_ })
# 首次启动后必须保持不变；第三方凭证继续只存 n8n credential manager。
N8N_ENCRYPTION_KEY=

# Creator Harness 生成引擎模式（可选，缺省 agent_loop）
# - agent_loop：LLM 自主规划 DAG、验收、修复、提问并持续到成功
# - blueprint / toolcalls：兼容旧模式，仅显式配置时使用
# - chain / incremental：命令链增量（逃生舱）
# OPENAGENT_GENERATOR_MODE=agent_loop
