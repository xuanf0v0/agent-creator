# 飞书自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# QQ 开放平台机器人
QQ_BOT_APP_ID=
QQ_BOT_SECRET=

# n8n 连接器后端（AutoFlow 2.0 集成）
# 生成方式：-join ((48..57) + (97..122) | Get-Random -Count 32 | ForEach-Object { [char]$_ })
# 首次启动后必须保持不变；第三方凭证继续只存 n8n credential manager。
N8N_ENCRYPTION_KEY=

# Creator Harness 生成引擎模式（可选，缺省 toolcalls）
# - blueprint：一次直出完整工作流（create 默认）
# - toolcalls：模型自主规划多个图操作、逐个校验（modify/repair 默认）
# - chain / incremental：命令链增量（逃生舱）
# OPENAGENT_GENERATOR_MODE=toolcalls
